# Обязательно: секретный ключ Django (32+ символов).
# Генерация: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# По умолчанию False (без debug-страниц).
# Для локальной разработки: DJANGO_DEBUG=True
DJANGO_DEBUG=

# Через запятую. По умолчанию "*".
# Для прода: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# Опционально: HTTPS-редирект
# DJANGO_SECURE_SSL_REDIRECT=True

# Опционально: HSTS (секунды)
# DJANGO_HSTS_SECONDS=31536000

# --- Gmail-интеграция (Google OAuth 2.0) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Обязательно включить Gmail API для проекта.
# Генерация ключа шифрования токенов:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
