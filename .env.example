# Django секретный ключ. Обязательно заменить перед публикацией!
# Сгенерировать новый: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-new-secret-key

# Режим отладки. В production: DJANGO_DEBUG=False
DJANGO_DEBUG=True

# Разрешённые хосты (через запятую). В production указать домен.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Принудительный HTTPS. Включить только при настроенном SSL.
# DJANGO_SECURE_SSL_REDIRECT=True

# HSTS в секундах. Включить только после проверки HTTPS.
# DJANGO_HSTS_SECONDS=31536000
