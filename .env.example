# Обязательно: секретный ключ Django (32+ символов).
# Генерация: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# По умолчанию False (без debug-страниц).
# Для локальной разработки: DJANGO_DEBUG=True
DJANGO_DEBUG=

# Через запятую. По умолчанию "*".
# Для прода: DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_ALLOWED_HOSTS=

# Опционально: HTTPS-редирект
# DJANGO_SECURE_SSL_REDIRECT=True

# Опционально: HSTS (секунды)
# DJANGO_HSTS_SECONDS=31536000
